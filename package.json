{
  "name": "inkdays",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0 --port 5180",
    "build": "tsc --noEmit && vite build && node scripts/pwa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src tests",
    "test": "vitest run",
    "start": "tsx scripts/coop-server.ts --public",
    "coop:server": "tsx scripts/coop-server.ts",
    "coop:server:badnet": "tsx scripts/coop-server.ts --bad-net",
    "coop:server:lan": "tsx scripts/coop-server.ts --lan"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
